# ---------------------------------------------------------------------------
# AIESES environment configuration (copy to .env for local overrides)
# Every value is optional — the app boots in DEMO mode with safe defaults.
# ---------------------------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development
# Path to the SQLite database file (":memory:" for ephemeral). Created + seeded on first boot.
DATABASE_PATH=./data/aieses.sqlite
# Secret used to sign JWT session cookies. REQUIRED in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Set to "true" when served over HTTPS behind a proxy (Render/Railway/Fly all are).
COOKIE_SECURE=false
TRUST_PROXY=false
# Comma-separated list of extra allowed browser origins (only needed for split deployments).
ALLOWED_ORIGINS=

# Demo mode: one-click demo logins + auto-seeding of synthetic demo data.
DEMO_MODE=true
# Re-seed the database from scratch on every boot (useful for ephemeral hackathon hosting).
RESET_DB_ON_BOOT=false

# AI provider (provider abstraction: "demo" | "openai-compatible")
# demo  -> deterministic curriculum-grounded Demo Tutor (no external calls, clearly labelled)
# openai-compatible -> any OpenAI-compatible chat API (OpenAI, Groq, OpenRouter, Ollama, vLLM, ...)
AI_PROVIDER=demo
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=20000

# DIKSHA adapter ("mock" | "live"). Live mode calls the public Sunbird/DIKSHA content search API
# and is NOT verified from this environment — mock mode serves clearly labelled DEMO DATA.
DIKSHA_MODE=mock
DIKSHA_BASE_URL=https://diksha.gov.in

# Server-side code execution adapter for languages that cannot run in the browser sandbox
# ("simulated" | "piston"). "simulated" is a clearly labelled deterministic demo runner.
# "piston" uses a remote Piston-compatible sandbox API (self-hosted or https://emkc.org/api/v2/piston).
EXEC_PROVIDER=simulated
PISTON_BASE_URL=https://emkc.org/api/v2/piston
EXEC_TIMEOUT_MS=5000
